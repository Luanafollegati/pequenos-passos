<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responsáveis - Pequenos Passos</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>


    <main class="login-container">


        <h1>Responsáveis</h1>


        <p>Gerenciamento de responsáveis cadastrados.</p>


        <p>
            <a href="/home">Voltar ao início</a>
        </p>


        <form action="/responsaveis" method="GET">
            <input
                type="text"
                name="busca"
                placeholder="Buscar responsável pelo nome"
                value="<%= busca %>"
            >
            <button type="submit">Buscar</button>
        </form>


        <p>
            <a href="/responsaveis/novo">+ Cadastrar responsável</a>
        </p>


        <% if (responsaveis.length === 0) { %>


            <p>Nenhum responsável encontrado.</p>


        <% } else { %>


            <% responsaveis.forEach(responsavel => { %>


                <div>
                    <h3><%= responsavel.nome %></h3>


                    <p>CPF: <%= responsavel.cpf %></p>
                    <p>E-mail: <%= responsavel.email %></p>
                    <p>Telefone: <%= responsavel.telefone %></p>


                    <a href="/responsaveis/editar/<%= responsavel.id %>">
                        Editar
                    </a>


                    <form
                        action="/responsaveis/excluir/<%= responsavel.id %>"
                        method="POST"
                        onsubmit="return confirm('Deseja realmente excluir este responsável?')"
                    >
                        <button type="submit">Excluir</button>
                    </form>
                </div>
                <hr>
            <% }) %>
        <% } %>
    </main>
</body>
</html>
