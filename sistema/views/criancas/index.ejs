<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crianças - Pequenos Passos</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>


    <main class="login-container">


        <h1>Crianças</h1>


        <p>Gerenciamento de crianças cadastradas.</p>


        <p><a href="/home">Voltar ao início</a></p>


        <p><a href="/criancas/novo">+ Cadastrar criança</a></p>


        <% if (criancas.length === 0) { %>


            <p>Nenhuma criança cadastrada.</p>


        <% } else { %>


            <% criancas.forEach(crianca => { %>


                <div>
                    <h3><%= crianca.nome %></h3>


                    <p>Data de nascimento:
                        <%= new Date(crianca.data_nascimento).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) %>
                    </p>


                    <p>Responsável: <%= crianca.nome_responsavel %></p>


                    <a href="/criancas/editar/<%= crianca.id %>">
                        Editar
                    </a>


                    <form
                        action="/criancas/excluir/<%= crianca.id %>"
                        method="POST"
                        onsubmit="return confirm('Deseja realmente excluir esta criança?')"
                    >
                        <button type="submit">Excluir</button>
                    </form>
                </div>


                <hr>


            <% }) %>


        <% } %>


    </main>


</body>
</html>
