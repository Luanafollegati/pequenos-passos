<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crianças - Pequenos Passos</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>


    <main class="login-container">


        <h1>
            <%= crianca ? 'Editar Criança' : 'Nova Criança' %>
        </h1>


        <form
            action="<%= crianca ? '/criancas/editar/' + crianca.id : '/criancas' %>"
            method="POST"
        >


            <label for="nome">Nome completo da criança</label>
            <input
                type="text"
                id="nome"
                name="nome"
                value="<%= crianca ? crianca.nome : '' %>"
                required
            >


            <label for="data_nascimento">Data de nascimento</label>
            <input
                type="date"
                id="data_nascimento"
                name="data_nascimento"
                value="<%= crianca ? new Date(crianca.data_nascimento).toISOString().slice(0, 10) : '' %>"
                required
            >


            <label for="responsavel_id">Responsável</label>
            <select id="responsavel_id" name="responsavel_id" required>


                <option value="">Selecione um responsável</option>


                <% responsaveis.forEach(responsavel => { %>


                    <option
                        value="<%= responsavel.id %>"
                        <%= crianca && crianca.responsavel_id === responsavel.id ? 'selected' : '' %>
                    >
                        <%= responsavel.nome %>
                    </option>


                <% }) %>


            </select>


            <button type="submit">
                <%= crianca ? 'Salvar alterações' : 'Cadastrar criança' %>
            </button>


        </form>


        <p><a href="/criancas">Voltar para crianças</a></p>


    </main>


</body>
</html>
