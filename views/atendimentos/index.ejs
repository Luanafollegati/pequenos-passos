<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Atendimentos - Pequenos Passos</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main class="login-container">
        <h1>Atendimentos</h1>


        <p>
            <a href="/home">Voltar ao início</a>
        </p>


        <p>
            <a href="/atendimentos/novo">+ Novo atendimento</a>
        </p>


        <% if (atendimentos.length === 0) { %>
            <p>Nenhum atendimento cadastrado.</p>
        <% } else { %>
            <% atendimentos.forEach(atendimento => { %>
                <section>
                    <hr>


                    <h2><%= atendimento.nome_crianca %></h2>


                    <p>
                        <strong>Responsável:</strong>
                        <%= atendimento.nome_responsavel %>
                    </p>


                    <p>
                        <strong>Data:</strong>
                        <%= new Date(atendimento.data_atendimento).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) %>
                    </p>


                    <p>
                        <strong>Horário:</strong>
                        <%= String(atendimento.horario).slice(0, 5) %>
                    </p>


                    <p>
                        <strong>Motivo:</strong>
                        <%= atendimento.motivo %>
                    </p>


                    <p>
                        <strong>Situação:</strong>
                        <%= atendimento.situacao %>
                    </p>


                    <a href="/atendimentos/editar/<%= atendimento.id %>">
                        Editar
                    </a>


                    <form
                        action="/atendimentos/excluir/<%= atendimento.id %>"
                        method="POST"
                        onsubmit="return confirm('Deseja realmente excluir este atendimento?')"
                    >
                        <button type="submit">Excluir</button>
                    </form>
                </section>
            <% }) %>
        <% } %>
    </main>
</body>
</html>
